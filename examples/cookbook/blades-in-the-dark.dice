Scale = scale().step("BAD").step("MESSY").step("CLEAN").step("CRITICAL")

def desperate_label(faces):
    high = max(faces)
    if high == 6:
        if len([f for f in faces if f == 6]) >= 2:
            return "CRITICAL"
        return "CLEAN"
    if high >= 4:
        return "MESSY"
    return "BAD"

def code_label(n):
    if n == 6:
        return "CRITICAL"
    if n >= 4:
        return "CLEAN"
    if n >= 1:
        return "MESSY"
    return "BAD"

output("0d", classify(keep_lowest(2, 6, 1), Scale, desperate_label))

for dice in range(1, 5):
    codes = pool_map(dice_pool(dice, 6), code_label)
    output("{}d".format(dice), classify(codes, Scale, code_label))
