# D&D 5e-style d20 check: nat 1 / nat 20, then total vs DC (modifier applied in the rule).
# Advantage: 2d20kh1; try 1d20 or 2d20kl1 for a normal roll / disadvantage.
Scale = scale(["CRITICAL_FAIL", "FAIL", "SUCCESS", "CRITICAL_SUCCESS"])
DC = 15
MOD = 5

def label(n):
    if n == 1:
        return "CRITICAL_FAIL"
    if n == 20:
        return "CRITICAL_SUCCESS"
    if n + MOD >= DC:
        return "SUCCESS"
    return "FAIL"

natural = 2d20kh1
out = classify(natural, Scale, label)
output("advantage_check", out)
output("p_hit_or_better", out.p_at_least("SUCCESS"))
