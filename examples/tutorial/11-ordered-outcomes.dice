# Ordered outcome bands on a numeric roll (d20-style thresholds).
Scale = (
    scale()
    .step("CRITICAL_FAIL", ..5)
    .step("FAIL", 6..10)
    .step("SUCCESS", 11..15)
    .step("CRITICAL_SUCCESS", 16..)
)
roll = 1d20
out = roll.bucket(Scale)
output("check", out)
output("p_success_plus", out.p_at_least("SUCCESS"))
